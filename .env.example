# ==============================================================================
# Odwołania2JSON — konfiguracja API (skopiuj do .env i wpisz swój klucz API)
# ==============================================================================

# --- Regolo.ai (EU, open-weight qwen3.5-9b + clef-flash) ---
LLM_BASE_URL=https://api.regolo.ai/v1
LLM_MODEL=qwen3.5-9b
LLM_API_KEY=your_regolo_api_key_here
LLM_THINKING_KWARG=true

DECIDER_REMOTE_URL=https://api.regolo.ai/v1/systemone
DECIDER_REMOTE_MODEL=clef-flash
DECIDER_API_KEY=your_regolo_api_key_here
